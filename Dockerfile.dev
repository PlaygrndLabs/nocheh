# Development image: dependencies are baked in; source is bind-mounted at runtime
# so edits trigger live reload (backend tsc --watch + node --watch, frontend Vite HMR).
FROM node:22-bookworm

WORKDIR /app

# Install backend deps (better-sqlite3 builds a native addon for this platform).
COPY package.json package-lock.json ./
RUN npm ci

# Install web deps in their own location.
COPY web/package.json ./web/
RUN npm --prefix web install

# Source is provided via bind mount in docker-compose.dev.yml; nothing else to copy.
EXPOSE 3000 5173
CMD ["npm", "run", "dev:watch"]
