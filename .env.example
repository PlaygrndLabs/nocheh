# Copy to .env, or run ./bin/nocheh init to generate it.
# ./bin/nocheh up generates blank internal credentials automatically.
NOCHEH_CONFIG_VERSION='1'
NOCHEH_PORT='8780'
NOCHEH_DASHBOARD_PORT='8783'
# Optional externally reachable authenticated dashboard base used in owner Telegram review links.
NOCHEH_DASHBOARD_URL=''
# Settings › Models. The default provider and model serve every part unless a
# part names its own. Providers: 'openai', 'anthropic', or the id of a custom
# provider below. Empty: Nocheh has no model until a
# provider is added in Settings › Models; replies and memory work wait.
NOCHEH_PROVIDER=''
NOCHEH_MODEL='claude-sonnet-5-5'
# Optional per-part provider and model; empty uses the default.
NOCHEH_REPLY_PROVIDER=''
NOCHEH_REPLY_MODEL=''
NOCHEH_MEMORY_PROVIDER=''
NOCHEH_MEMORY_MODEL=''
NOCHEH_GUARD_PROVIDER=''
NOCHEH_GUARD_MODEL=''
# Custom OpenAI-compatible providers, for example:
# '[{"id":"gateway","name":"My gateway","url":"https://gateway.example.com/v1"}]'
NOCHEH_PROVIDERS='[]'
# Their API keys by provider id: '{"gateway":"..."}'
NOCHEH_PROVIDER_KEYS='{}'
ANTHROPIC_API_KEY=''
NOCHEH_GUARD_MODE='on'
NOCHEH_SECURITY_RUNTIME='isolated'
NOCHEH_MEMORY_CONTEXT='evidence'
# Memory search embeddings: initial $5 pilot, then $5/month. 'openai' or the id
# of a custom provider that serves the same models.
NOCHEH_EMBEDDING_PROVIDER='openai'
# Supported: text-embedding-3-small or text-embedding-3-large (1536 dimensions).
NOCHEH_EMBEDDING_MODEL='text-embedding-3-small'
# The OpenAI provider's key, for embeddings and any part that uses OpenAI.
OPENAI_API_KEY=''
TELEGRAM_ENABLED='false'
TELEGRAM_BOT_TOKEN=''
TELEGRAM_OWNER_ID=''
TELEGRAM_GROUP_IDS=''
TELEGRAM_GROUP_ACCESS='{}'
# In groups, reply only when a message addresses the bot ('addressed': a reply
# to the bot, its @username, or its name opening the message) or to every
# permitted message ('all'). Every group message is archived either way.
TELEGRAM_GROUP_REPLIES='addressed'
# Comma-separated names that address the bot when they open a group message.
# Its Telegram display name and @username always work as well.
TELEGRAM_BOT_NAMES='Nocheh,نوچه'
# Memory of a group's forum topics: 'group' shares one memory across the group's
# General chat and every topic; 'topic' keeps each topic's memory separate.
TELEGRAM_TOPIC_MEMORY='group'
POSTGRES_PASSWORD=''
SERVICE_TOKEN=''
# Optional: ./bin/nocheh db generates a dedicated read-only database login.
NOCHEH_VIEWER_PASSWORD=''

# Three independent stores; init generates distinct internal credentials.
NOCHEH_STORAGE_LAYOUT='original-only-v1'
NOCHEH_ARCHIVE_PASSWORD=''
NOCHEH_DERIVED_PASSWORD=''
NOCHEH_CONTROL_PASSWORD=''
INNGEST_POSTGRES_PASSWORD=''
INNGEST_EVENT_KEY=''
INNGEST_SIGNING_KEY=''
# Days to keep Inngest run history of idle runs and Nocheh's spent workflow
# publication records and run links, and superseded Honcho context summaries;
# 0 keeps them forever.
NOCHEH_WORKFLOW_HISTORY_RETENTION_DAYS='14'
# Docker rotates each container's log at this size and keeps this many files.
NOCHEH_LOG_MAX_SIZE='10m'
NOCHEH_LOG_MAX_FILES='3'
# Isolated agent containers that may run at once (1-8, 2 GiB and 2 CPUs each),
# shared by Telegram replies, memory reviews, browser turns and schedules.
NOCHEH_PARALLEL_RUNS='4'
# Telegram chats answered at once (1 to NOCHEH_PARALLEL_RUNS); one chat's
# messages, including all topics of a group, are always answered in order.
NOCHEH_PARALLEL_REPLIES='3'
# Messages the secret guard checks at once (1-4); each check is one model call.
NOCHEH_PARALLEL_GUARD_CHECKS='3'
