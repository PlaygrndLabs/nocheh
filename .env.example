LOCAL_ENCRYPTION_SECRET=replace-with-at-least-16-characters
APP_AUTH_USERNAME=replace-with-your-username
APP_AUTH_PASSWORD=
# Optional. Defaults to LOCAL_ENCRYPTION_SECRET when unset.
# APP_AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
# Set true only when served over HTTPS.
APP_AUTH_SECURE_COOKIE=false
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# Hostname routed by the Cloudflare Tunnel. Used by scripts/bootstrap.sh to build
# the dashboard and Telegram webhook URLs. Blank means local-only.
PUBLIC_HOSTNAME=
# batch (recommended): the webhook buffers and the flush sweep analyses.
# immediate: analyses inside the webhook request, which Telegram will time out. Testing only.
MESSAGE_ANALYSIS_MODE=batch
LIVE_ANALYSIS_INTERVAL_SECONDS=300
LIVE_MAX_MESSAGES_PER_BATCH=50
# How often due batches are swept. In batch mode this is the ONLY thing that runs
# analysis: the webhook just buffers, so Telegram is never held open for a call that
# takes minutes. This interval is therefore also the worst-case delay between a batch
# becoming due and being analysed.
FLUSH_SWEEP_INTERVAL_SECONDS=60
MAX_AI_CONTEXT_TOKENS=4000
MAX_AI_OUTPUT_TOKENS=4000
MAX_RETRIEVED_MEMORIES=12
MAX_RECENT_MESSAGES=30
SUMMARY_EVERY_MESSAGES=100
SUMMARY_EVERY_MINUTES=60

# Image and voice understanding limits
MEDIA_MAX_ATTACHMENTS_PER_WINDOW=8
MEDIA_MAX_DOWNLOAD_BYTES=20971520
# Largest rendition sent inline to a perception model. The NVIDIA catalog endpoint
# showed no inline cap in testing (10.7MB of base64 accepted), so this is a latency
# guard. Keep it above Telegram's photo sizes: downscaling costs OCR accuracy.
MEDIA_MAX_INLINE_BYTES=5242880

# Secret guard
# Guard failures tolerated before a message is quarantined for inspection.
SECRET_GUARD_MAX_ATTEMPTS=5
SECRET_GUARD_MAX_INPUT_CHARACTERS=24000
SECRET_GUARD_MAX_OUTPUT_TOKENS=4000
# fail_closed (default): a guard outage stops analysis, the window stays buffered.
# degrade_to_patterns: analysis proceeds on pattern rules only. Availability over strictness.
# SECRET_GUARD_ON_FAILURE=fail_closed

# Model roles (managed via the /app dashboard; listed here for reference).
# Credentials are per provider; model ids are per role. Every role degrades
# independently, so a missing media model never blocks text analysis.

# Text analysis: memory, graph, tasks, suggestions. Blank means dry-run.
# AI_PROVIDER=nvidia
# OpenAI text-analysis pilot (keep AI_PROVIDER unchanged until you deliberately switch it).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=
# Image understanding: describes photos, screenshots, diagrams.
# AI_IMAGE_PROVIDER=nvidia
# Voice and audio understanding: transcribes and summarises voice notes.
# AI_AUDIO_PROVIDER=nvidia
# Secret guard: finds credentials pattern rules miss, such as a spoken password.
# AI_GUARD_PROVIDER=gemini
# Memory embeddings: associative recall. Blank means retrieval uses word overlap only,
# which cannot surface a memory phrased differently from the question.
# AI_EMBEDDING_PROVIDER=nvidia

# NVIDIA API Catalog
# NVIDIA_API_KEY=
# Optional. Defaults to z-ai/glm-5.2.
# NVIDIA_MODEL=z-ai/glm-5.2
# Retrieval model. Required when AI_EMBEDDING_PROVIDER=nvidia.
# The nv-embedqa family needs input_type; set NVIDIA_EMBEDDING_INPUT_TYPE=false only if
# your endpoint rejects that field. Verify the model id against the live catalog.
# NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
# Optional. Both default to nvidia/nemotron-3-nano-omni-30b-a3b-reasoning.
# Verify the model id against the live catalog before relying on it.
# Verified: reads images, and transcribes Telegram's OGG/Opus with no transcoding.
# NVIDIA_IMAGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Model id is required when NVIDIA fills the guard role. Verified good:
# nvidia/nvidia-nemotron-nano-9b-v2. Do NOT use nvidia/nemotron-3-nano-30b-a3b —
# it returned an empty result for text containing obvious secrets.
# NVIDIA_GUARD_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# Optional. Defaults to https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_BASE_URL=
# Set false only if the endpoint rejects response_format json_object.
# NVIDIA_JSON_RESPONSE_FORMAT=true

# Anthropic Claude. Model ids are required.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_GUARD_MODEL=

# Google Gemini. Model ids are required.
# Alternative for any role. Also accepts OGG/Opus inline.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_IMAGE_MODEL=
# GEMINI_AUDIO_MODEL=
# GEMINI_GUARD_MODEL=
# GEMINI_BASE_URL=

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# Comma-separated Telegram IDs. If set, webhook messages outside these IDs are ignored.
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOWED_USER_IDS=

# Optional Notion MCP sync
# NOTION_MCP_COMMAND=
# NOTION_MCP_ARGS=
# NOTION_DATABASE_ID=
# NOTION_MCP_CREATE_TOOL=notion_create_task
# NOTION_MCP_UPDATE_TOOL=notion_update_task
