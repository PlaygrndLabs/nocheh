LOCAL_ENCRYPTION_SECRET=replace-with-at-least-16-characters
APP_AUTH_USERNAME=replace-with-your-username
APP_AUTH_PASSWORD=
# Optional. Defaults to LOCAL_ENCRYPTION_SECRET when unset.
# APP_AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
# Set true only when served over HTTPS.
APP_AUTH_SECURE_COOKIE=false
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# Hostname routed by the Cloudflare Tunnel. Used by scripts/bootstrap.sh to build
# the dashboard and Telegram webhook URLs. Blank means local-only.
PUBLIC_HOSTNAME=
MESSAGE_ANALYSIS_MODE=batch
LIVE_ANALYSIS_INTERVAL_SECONDS=300
LIVE_MAX_MESSAGES_PER_BATCH=50
MAX_AI_CONTEXT_TOKENS=4000
MAX_AI_OUTPUT_TOKENS=4000
MAX_RETRIEVED_MEMORIES=12
MAX_RECENT_MESSAGES=30
SUMMARY_EVERY_MESSAGES=100
SUMMARY_EVERY_MINUTES=60

# Setup dashboard (managed via the /app dashboard; listed here for reference)
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=
# Optional. Defaults to z-ai/glm-5.2.
# NVIDIA_MODEL=z-ai/glm-5.2
# Optional. Defaults to https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_BASE_URL=
# Set false only if the endpoint rejects response_format json_object.
# NVIDIA_JSON_RESPONSE_FORMAT=true
# Alternative provider. Model id is required.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# Comma-separated Telegram IDs. If set, webhook messages outside these IDs are ignored.
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOWED_USER_IDS=

# Optional Notion MCP sync
# NOTION_MCP_COMMAND=
# NOTION_MCP_ARGS=
# NOTION_DATABASE_ID=
# NOTION_MCP_CREATE_TOOL=notion_create_task
# NOTION_MCP_UPDATE_TOOL=notion_update_task
