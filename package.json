{
  "name": "@nocheh/services",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "test:dashboard": "node --test test/dashboard-*.test.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/src/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js test/dashboard-*.test.mjs",
    "graphify:extract": "graphify extract . --no-cluster --out .",
    "graphify:report": "graphify cluster-only . --no-label",
    "graphify:update": "python3 scripts/graphify_ast.py"
  },
  "dependencies": {
    "@xyflow/react": "12.11.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "17.0.2",
    "inngest": "4.20.0",
    "lucide-react": "1.46.0",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.10",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "typescript": "5.9.3"
  }
}
