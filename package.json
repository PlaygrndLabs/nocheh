{
  "name": "@nocheh/services",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build:dashboard": "node tools/build/build-dashboard.mjs",
    "test:dashboard": "node --test test/dashboard-*.test.mjs",
    "test:dashboard-browser": "node --test test/dashboard-pages.browser.mjs",
    "format:dashboard": "prettier --write 'dashboard/**/*.{ts,tsx,css}' test/dashboard-pages.browser.mjs",
    "check:dashboard-format": "prettier --check 'dashboard/**/*.{ts,tsx,css}' test/dashboard-pages.browser.mjs",
    "build": "node tools/build/build.mjs",
    "start": "node dist/src/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js test/dashboard-*.test.mjs",
    "graphify:extract": "graphify extract . --no-cluster --out .",
    "graphify:report": "graphify cluster-only . --no-label",
    "graphify:update": "python3 -m tools.development.graphify_ast"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "17.0.2",
    "inngest": "4.26.0",
    "lucide-react": "1.61.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
