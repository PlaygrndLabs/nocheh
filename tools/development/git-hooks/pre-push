#!/bin/sh
# Refuses a push that would publish the owner's private details (tools/development/privacy_scan.py).
# Install once per checkout: git config core.hooksPath tools/development/git-hooks
# A pre-push hook already kept in the checkout's own hooks folder still runs first.
zero=0000000000000000000000000000000000000000
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
cd "$(git rev-parse --show-toplevel)" || exit 1
input=$(cat)
if [ -x "$common/hooks/pre-push" ]; then
  printf '%s\n' "$input" | "$common/hooks/pre-push" "$@" || exit 1
fi
printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] && [ "$local_sha" != "$zero" ] || continue
  # Only commits no remote has yet: ones already published, such as a merge of main, can't be taken back here.
  python3 -m tools.development.privacy_scan --range "$local_sha --not --remotes" || exit 1
done
